# Copy this file to .env and fill in ONE provider's key below.
# Gemini is the default/recommended provider for this project (free tier,
# fast, reliable). NVIDIA NIM is supported as a fallback provider if you'd
# rather use that instead — you only need ONE of the two.

# ---- Gemini (recommended) ------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Model to use. gemini-2.5-flash-lite was deprecated by Google — use
# gemini-3.5-flash-lite instead (this is what was tested end-to-end).
GEMINI_MODEL=gemini-3.5-flash-lite

# If you hit "quota exceeded" (429) errors on gemini-3.5-flash-lite — its
# free-tier daily quota is small and running the pipeline repeatedly during
# testing/demos burns through it fast — switch to a model with a well-
# documented, more generous free tier instead:
# GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: per-request timeout in ms (default 60000).
# GEMINI_TIMEOUT_MS=60000

# Optional: minimum ms between LLM calls, used to stay under the free
# tier's requests-per-minute cap. Default 4500ms (~13/min). Raise this if
# you still see 429 rate-limit errors specifically (not "quota exceeded" —
# that's a daily cap, this setting won't fix that one, switching model or
# waiting will).
# LLM_MIN_INTERVAL_MS=4500

# ---- Optional: separate key for the chatbot assistant ---------------------
# By default the transaction pipeline (per-transaction diagnosis, ~90+ calls
# every run) and the chatbot on the Assistant page share ONE Gemini key/quota
# — so a demo where you re-run the pipeline a few times can burn through the
# day's quota before anyone even opens the chatbot.
#
# To keep them independent, get a SECOND free key from a different Google
# account/project at https://aistudio.google.com/apikey and set it here. The
# assistant will use this key (and, optionally, its own model) instead of
# the main GEMINI_API_KEY above; the pipeline is untouched and keeps using
# GEMINI_API_KEY as before. Leave both commented out to keep sharing one key.
# GEMINI_API_KEY_ASSISTANT=your-second-gemini-key-here
# GEMINI_MODEL_ASSISTANT=gemini-3.5-flash-lite

# ---- NVIDIA NIM (alternative — only used if GEMINI_API_KEY is not set) --
# Get a free key at https://build.nvidia.com (open any model -> "Get API Key").
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# NVIDIA_TIMEOUT_MS=45000

# ---- General --------------------------------------------------------------
# How many transactions to process in parallel when calling the LLM.
# PIPELINE_CONCURRENCY=8

# Port the API server listens on (default 4000).
# PORT=4000
