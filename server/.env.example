# Copy this file to .env and fill in your key to enable real LLM reasoning.
# Get a free key at https://build.nvidia.com (open any model -> "Get API Key").
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override the default model (default is meta/llama-3.1-70b-instruct,
# widely available on build.nvidia.com). If a model 404s / isn't on your
# account, open https://build.nvidia.com, pick any model card you DO have
# access to, and copy its exact model ID here, e.g.:
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_MODEL=mistralai/mixtral-8x22b-instruct-v0.1

# Optional: how many transactions to process in parallel when calling the LLM.
# PIPELINE_CONCURRENCY=8
